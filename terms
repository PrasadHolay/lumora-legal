    <style>
        :root {
            --bg: #FEFDFB;
            --white: #FFFFFF;
            --sage: #5A7A6A;
            --gold: #C89525;
            --coral: #993C1D;
            --text-dark: #2D2D2D;
            --text-body: #555555;
            --text-muted: #888888;
            --hairline: rgba(45, 45, 45, 0.08);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--text-dark);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 720px;
            margin: 0 auto;
            padding: 40px 22px 64px;
        }

        /* Editorial hero */
        .hero { padding: 24px 0 6px; }
        .eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.4px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 10px;
        }
        .hero h1 {
            font-family: 'Cormorant', Georgia, serif;
            font-weight: 700;
            font-size: 44px;
            line-height: 1.05;
            letter-spacing: -0.5px;
            color: var(--text-dark);
        }

        /* Gold ornament */
        .ornament {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            opacity: 0.45;
            margin: 22px 0 26px;
        }
        .ornament .line { width: 40px; height: 1px; background: var(--gold); }
        .ornament .diamond { width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); }

        /* Intro + summary cards */
        .card {
            background: var(--white);
            border: 0.5px solid var(--hairline);
            border-radius: 14px;
            padding: 20px 22px;
            margin-bottom: 18px;
            box-shadow: 0 1px 4px rgba(45, 45, 45, 0.05);
        }
        .intro-text { font-size: 14px; color: var(--text-body); }

        .summary h3 {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 14px;
        }
        .summary-item { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 9px; }
        .summary-item:last-child { margin-bottom: 0; }
        .summary-item .check { color: var(--sage); font-weight: 700; font-size: 14px; flex-shrink: 0; line-height: 1.5; }
        .summary-item p { font-size: 13.5px; color: var(--text-body); }

