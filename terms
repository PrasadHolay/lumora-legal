        .section-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 14px; }
        .section-num {
            font-family: 'Cormorant', Georgia, serif;
            font-weight: 700;
            font-size: 30px;
            line-height: 1;
            letter-spacing: -0.5px;
            color: var(--gold);
            min-width: 38px;
        }
        .section-head h2 {
            font-family: 'Cormorant', Georgia, serif;
            font-weight: 700;
            font-size: 24px;
            letter-spacing: -0.3px;
            color: var(--text-dark);
            line-height: 1.15;
        }
        .section-body { padding-left: 52px; }
        .section-body p { font-size: 14px; color: var(--text-body); margin-bottom: 14px; }
        .section-body p:last-child { margin-bottom: 0; }

        .subsection { margin-top: 14px; }
        .subsection .label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            color: var(--sage);
            margin-bottom: 5px;
