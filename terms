            font-weight: 700;
            letter-spacing: 3px;
            color: var(--sage);
            margin-bottom: 10px;
        }
        .footer p { font-size: 12px; color: var(--text-muted); line-height: 1.7; }
        .footer a { color: var(--sage); text-decoration: none; font-weight: 600; }

        @media (max-width: 480px) {
